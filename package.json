{
  "name": "kiloton",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "description": "Kiloton — run many Kilo CLI agents in one customizable dashboard.",
  "scripts": {
    "start": "node server.js",
    "update": "git pull --ff-only && npm install",
    "lint": "eslint server.js lib public/app.js test",
    "test": "node test/e2e.mjs && node test/client-e2e.mjs",
    "test:unit": "node test/unit.mjs",
    "test:b1": "node test/b1-mouse.mjs",
    "test:client-e2e": "node test/client-e2e.mjs",
    "test:stress": "KILOTON_E2E_AGENTS=30 node test/e2e.mjs"
  },
  "dependencies": {
    "@xterm/xterm": "^5.5.0",
    "express": "^4.19.2",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1"
  }
}
